---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.slug },
    props:  { note },
  }));
}

type Props = { note: CollectionEntry<'notes'> };

const { note } = Astro.props;

const { Content, headings } = await note.render();

interface TocGroup {
  depth: number;
  slug: string;
  text: string;
  children: { depth: number; slug: string; text: string }[];
}

const tocTree: TocGroup[] = [];
let currentGroup: TocGroup | null = null;

for (const h of headings) {
  if (h.depth === 2) {
    currentGroup = { ...h, children: [] };
    tocTree.push(currentGroup);
  } else if (h.depth === 3) {
    if (currentGroup) {
      currentGroup.children.push(h);
    } else {
      tocTree.push({ ...h, children: [] });
    }
  }
}

const fmt = (date: Date) =>
  date.toLocaleDateString('en-CA', { timeZone: 'UTC' });

const formatFullDate = (date: Date) => {
  const months = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];
  const day = date.getUTCDate();
  const month = months[date.getUTCMonth()];
  const year = date.getUTCFullYear();

  const getOrdinal = (n: number) => {
    const s = ['th', 'st', 'nd', 'rd'];
    const v = n % 100;
    return s[(v - 20) % 10] || s[v] || s[0];
  };

  return `${month} ${day}${getOrdinal(day)}, ${year}`;
};

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const otherNotes = allNotes
  .filter((n) => n.slug !== note.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={note.data.title} description={note.data.description}>
  <a href={`${base}/notes`} class="back-link">← notes</a>


  <div class="note-layout">

    <aside class="toc" id="toc" aria-label="Table of Contents">
      <div class="toc-label">On This Page</div>
      <nav id="toc-nav" class="toc-tree">
        {tocTree.map((item) => {
          const hasChildren = item.children.length > 0;
          return (
            <div class={`toc-group ${hasChildren ? 'has-children' : ''}`} data-group-slug={item.slug}>
              <div class="toc-row">
                {hasChildren ? (
                  <button
                    type="button"
                    class="toc-folder-btn"
                    aria-label={`Toggle subheadings for ${item.text}`}
                    title="Toggle subheadings"
                  >
                    <svg
                      class="folder-chevron"
                      width="8"
                      height="8"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                ) : (
                  <span class="toc-leaf-dot" aria-hidden="true">·</span>
                )}
                <a href={`#${item.slug}`} class="toc-link toc-h2" data-slug={item.slug}>
                  {item.text}
                </a>
              </div>

              {hasChildren && (
                <div class="toc-children">
                  {item.children.map((sub) => (
                    <div class="toc-subrow">
                      <a
                        href={`#${sub.slug}`}
                        class="toc-link toc-h3"
                        data-slug={sub.slug}
                        data-parent-slug={item.slug}
                      >
                        {sub.text}
                      </a>
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>
    </aside>

    <div class="note-main">
      <h1 class="note-title">{note.data.title}</h1>
      <div class="note-meta">
        <span class="note-date">{formatFullDate(note.data.date)}</span>
        
        {note.data.tags.length > 0 && (
          <span class="meta-sep">·</span>
        )}
        <div class="note-tags-list">
          {note.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>

        {note.data.reference && !note.data.referenceText?.toLowerCase().includes('cover image') && (
          <>
            <span class="meta-sep">·</span>
            <a 
              href={note.data.reference} 
              class="note-ref-link" 
              target="_blank" 
              rel="noopener noreferrer"
            >
              [{note.data.referenceText || 'reference'}]
            </a>
          </>
        )}
      </div>

      <div class="prose">
        <Content />
      </div>

      {otherNotes.length > 0 && (
        <section class="other-notes-section" aria-label="Other blog posts">
          <div class="other-notes-header">
            <div class="other-notes-label">
              <span class="prompt">//</span> other notes
            </div>
            <div class="slider-controls">
              <button
                type="button"
                class="slider-btn"
                id="slide-prev-btn"
                aria-label="Scroll other notes left"
              >
                ←
              </button>
              <button
                type="button"
                class="slider-btn"
                id="slide-next-btn"
                aria-label="Scroll other notes right"
              >
                →
              </button>
            </div>
          </div>

          <div class="other-notes-slider" id="other-notes-slider" role="region" aria-label="Other notes slider">
            {otherNotes.map((other) => (
              <a href={`${base}/notes/${other.slug}`} class="other-note-card">
                <div class="other-card-meta">
                  <time>{fmt(other.data.date)}</time>
                  {other.data.tags && other.data.tags.length > 0 && (
                    <span class="other-card-tag">#{other.data.tags[0]}</span>
                  )}
                </div>
                <h3 class="other-card-title">{other.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  :global(main) {
    max-width: 1400px !important;
    padding-left: 2rem !important;
    padding-right: 2rem !important;
  }

  .note-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 2rem;
    width: 230px;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-2) transparent;
  }

  .toc::-webkit-scrollbar {
    width: 3px;
  }

  .toc::-webkit-scrollbar-thumb {
    background: var(--border-2);
    border-radius: 2px;
  }

  .toc-label {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 0.5px solid var(--border);
  }

  .toc-tree {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    align-items: stretch;
  }

  .toc-group {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .toc-row {
    display: flex;
    align-items: flex-start;
    width: 100%;
    gap: 4px;
    padding: 1px 0;
  }

  .toc-folder-btn {
    background: none;
    border: none;
    padding: 0;
    width: 14px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 1px;
    transition: color 0.15s ease;
  }

  .toc-folder-btn:hover {
    color: var(--accent-bright);
  }

  .folder-chevron {
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
    transform: rotate(0deg);
  }

  .toc-group.is-open > .toc-row .folder-chevron {
    transform: rotate(90deg);
    color: var(--accent);
  }

  .toc-leaf-dot {
    width: 14px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #2c3a2e;
    font-size: 13px;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 1px;
    user-select: none;
  }

  .toc-link {
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.35;
    display: block;
    flex: 1;
    text-decoration: none;
    transition: all 0.15s ease;
    overflow-wrap: break-word;
    word-break: break-word;
    opacity: 0.7;
    padding: 1px 0;
  }

  .toc-link:hover {
    color: var(--accent-bright);
    opacity: 1;
  }

  .toc-link.active {
    color: var(--accent-bright);
    opacity: 1;
    font-weight: 500;
    text-shadow: 0 0 4px rgba(164, 226, 52, 0.4);
  }

  .toc-group.has-active-child > .toc-row .toc-h2 {
    color: var(--text);
    opacity: 0.95;
  }

  .toc-children {
    margin-left: 6px;
    padding-left: 10px;
    border-left: 1px solid #1a271c;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    transition: max-height 0.25s cubic-bezier(0, 1, 0, 1), opacity 0.2s ease, visibility 0.2s;
  }

  .toc-group.is-open > .toc-children {
    max-height: 500px;
    opacity: 1;
    visibility: visible;
    transition: max-height 0.3s ease-in-out, opacity 0.25s ease;
  }

  .toc-subrow {
    padding: 2px 0;
  }

  .toc-h3 {
    font-size: 11px;
    color: #7b947b;
    opacity: 0.8;
  }

  .toc-h3:hover {
    color: var(--accent-bright);
    opacity: 1;
  }

  .toc-h3.active {
    color: var(--accent-bright);
    opacity: 1;
    font-weight: 500;
    text-shadow: 0 0 4px rgba(164, 226, 52, 0.4);
  }

  .note-main {
    min-width: 0;
    width: 100%;
  }

  .note-title {
    font-size: 32px;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.2;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }

  .note-meta {
    font-size: 13px;
    color: var(--subtle);
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 0.5px solid var(--border);
  }

  .note-date {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--subtle);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .note-tags-list {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .meta-sep { color: var(--border-2); }

  .tag {
    color: var(--accent);
    font-size: 11px;
    background: #060906;
    border: 0.5px solid var(--border-2);
    border-radius: 4px;
    padding: 2px 7px;
    display: inline-flex;
    align-items: center;
    line-height: 1.35;
    letter-spacing: 0.02em;
    transition: all 0.15s ease;
  }

  .tag:hover {
    color: var(--accent-bright);
    border-color: var(--accent);
    background: rgba(118, 185, 0, 0.06);
  }

  .prose {
    font-size: 15.5px;
    color: var(--text);
    line-height: 1.8;
    max-width: none !important;
    margin: 0 !important;
    width: 100%;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
    max-width: none;
    color: var(--text);
  }

  .prose :global(pre) {
    width: 100%;
    max-width: 100%;
  }

  .prose :global(h2) {
    font-size: 20px;
    font-weight: 600;
    color: var(--heading);
    margin: 3rem 0 1rem;
    padding-top: 0.25rem;
  }

  .prose :global(h3) {
    font-size: 16px;
    font-weight: 600;
    color: var(--heading);
    margin: 2rem 0 0.65rem;
  }

  .prose :global(a) {
    border-bottom: 0.5px solid var(--border-2);
    transition: color 0.15s;
  }
  .prose :global(a:hover) { color: var(--accent-bright); }

  .prose :global(img) {
    display: block;
    max-width: min(100%, 680px);
    width: auto;
    height: auto;
    margin: 2rem auto 0.5rem auto;
    border-radius: 6px;
    border: 1px solid var(--border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .prose :global(p:has(> img)) {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .prose :global(figure) {
    margin: 2rem auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .prose :global(figure img) {
    margin: 0 auto 0.5rem auto;
  }

  .prose :global(figcaption),
  .prose :global(.caption),
  .prose :global(p:has(> img) > em),
  .prose :global(p:has(> img) + p:has(> em:only-child)),
  .prose :global(p:has(> img) + p > em:only-child) {
    font-size: 11.5px;
    color: #8da48d;
    text-align: center;
    display: block;
    line-height: 1.5;
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
    font-style: normal;
  }

  .note-ref-link {
    font-size: 11px;
    color: var(--subtle);
    text-decoration: none;
    font-family: monospace;
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }

  .note-ref-link:hover {
    color: var(--accent-bright);
    text-shadow: 0 0 4px rgba(164, 226, 52, 0.4);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    :global(main) { max-width: 100% !important; }


    .note-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .toc {
      position: static;
      background: var(--bg-2);
      border: 0.5px solid var(--border);
      border-radius: 6px;
      padding: 1rem 1.1rem;
      margin-bottom: 2rem;
    }

    .note-title { font-size: 22px; }
  }

  .back-link {
  display: inline-block;
  font-family: monospace;
  font-size: 13px;
  color: var(--subtle);
  text-decoration: none;
  margin-top: 1rem;    
  margin-bottom: 2rem;  
  transition: color 0.15s ease;
}

  .back-link:hover {
    color: var(--accent-bright);
  }

  /* ── Other notes sliding bar ── */
  .other-notes-section {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 0.5px solid var(--border);
  }

  .other-notes-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .other-notes-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .slider-controls {
    display: flex;
    gap: 0.4rem;
  }

  .slider-btn {
    background: #060906;
    border: 0.5px solid var(--border);
    color: var(--muted);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .slider-btn:hover:not(:disabled) {
    color: var(--accent-bright);
    border-color: var(--accent);
    background: rgba(118, 185, 0, 0.08);
  }

  .slider-btn:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .other-notes-slider {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    padding: 0.25rem 0 0.85rem 0;
    -webkit-overflow-scrolling: touch;
  }

  .other-notes-slider::-webkit-scrollbar {
    height: 4px;
  }

  .other-notes-slider::-webkit-scrollbar-track {
    background: var(--bg-2);
    border-radius: 2px;
  }

  .other-notes-slider::-webkit-scrollbar-thumb {
    background: var(--border-2);
    border-radius: 2px;
  }

  .other-notes-slider::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  .other-note-card {
    flex: 0 0 250px;
    min-width: 250px;
    max-width: 250px;
    scroll-snap-align: start;
    background: #060906;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.9rem 1rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.6rem;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .other-note-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4),
                0 0 10px rgba(118, 185, 0, 0.1);
  }

  .other-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    color: var(--subtle);
  }

  .other-card-tag {
    color: var(--accent);
    font-size: 10px;
  }

  .other-card-title {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--heading);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .other-note-card:hover .other-card-title {
    color: var(--accent-bright);
    text-shadow: 0 0 4px rgba(164, 226, 52, 0.35);
  }
</style>

<script>
  function setupTocDropdown() {
    const groups = Array.from(document.querySelectorAll<HTMLElement>('.toc-group'));
    const allLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    const toggleBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.toc-folder-btn'));

    if (allLinks.length === 0) return;

    const linkHeadingPairs = allLinks
      .map((link) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return null;
        const id = decodeURIComponent(href.slice(1));
        const heading = document.getElementById(id);
        return heading ? { link, heading, slug: id } : null;
      })
      .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement; slug: string } => item !== null);

    if (linkHeadingPairs.length === 0) return;

    // Toggle button click handler (folder chevron)
    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const group = btn.closest('.toc-group');
        if (group) {
          group.classList.toggle('is-open');
        }
      });
    });

    // Clicking an H2 link that has subheadings unfolds its folder
    allLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const group = link.closest('.toc-group');
        if (group && group.classList.contains('has-children')) {
          group.classList.add('is-open');
        }
      });
    });

    function updateActiveState(activePair: { link: HTMLAnchorElement; heading: HTMLElement; slug: string }) {
      allLinks.forEach((l) => l.classList.remove('active'));
      activePair.link.classList.add('active');

      const activeSlug = activePair.slug;
      const isH3 = activePair.link.classList.contains('toc-h3');
      const parentSlug = activePair.link.dataset.parentSlug;

      groups.forEach((group) => {
        const groupSlug = group.dataset.groupSlug;
        const isCurrentGroup = groupSlug === activeSlug || (isH3 && groupSlug === parentSlug);

        if (isCurrentGroup) {
          if (group.classList.contains('has-children')) {
            group.classList.add('is-open');
          }
          if (isH3) {
            group.classList.add('has-active-child');
          } else {
            group.classList.remove('has-active-child');
          }
        } else {
          group.classList.remove('is-open');
          group.classList.remove('has-active-child');
        }
      });
    }

    function onScrollUpdate() {
      const scrollY = window.scrollY || window.pageYOffset;
      const viewportHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;

      if (scrollY + viewportHeight >= docHeight - 80) {
        updateActiveState(linkHeadingPairs[linkHeadingPairs.length - 1]);
        return;
      }

      const triggerOffset = 140;
      let currentActive = linkHeadingPairs[0];

      for (let i = 0; i < linkHeadingPairs.length; i++) {
        const rect = linkHeadingPairs[i].heading.getBoundingClientRect();
        if (rect.top <= triggerOffset) {
          currentActive = linkHeadingPairs[i];
        } else {
          break;
        }
      }

      updateActiveState(currentActive);
    }

    let ticking = false;
    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScrollUpdate();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestTick, { passive: true });
    window.addEventListener('resize', requestTick, { passive: true });

    onScrollUpdate();
  }

  setupTocDropdown();
  document.addEventListener('astro:page-load', setupTocDropdown);

  function setupOtherNotesSlider() {
    const slider = document.getElementById('other-notes-slider');
    const prevBtn = document.getElementById('slide-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('slide-next-btn') as HTMLButtonElement | null;

    if (!slider || !prevBtn || !nextBtn) return;

    function updateButtonStates() {
      if (!slider || !prevBtn || !nextBtn) return;
      const atStart = slider.scrollLeft <= 5;
      const atEnd = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 5;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    }

    prevBtn.addEventListener('click', () => {
      slider.scrollBy({ left: -266, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      slider.scrollBy({ left: 266, behavior: 'smooth' });
    });

    slider.addEventListener('scroll', updateButtonStates, { passive: true });
    window.addEventListener('resize', updateButtonStates, { passive: true });
    updateButtonStates();
  }

  setupOtherNotesSlider();
  document.addEventListener('astro:page-load', setupOtherNotesSlider);
</script>