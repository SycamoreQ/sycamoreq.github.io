---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = await getCollection('notes', ({ data }) => !data.draft);
// Sort notes by date descending
const sortedNotes = notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (date: Date) =>
  date.toLocaleDateString('en-CA', { timeZone: 'UTC' });

const allNotes = await getCollection('notes', ({ data }) => !data.draft);

const tagCounts: Record<string, number> = {};
allNotes.forEach(note => {
  note.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base title="notes" description="Writing and documentation">
  <div class="notes-container">
    <h1 class="page-title">notes/</h1>
    
    <div class="notes-grid">
      {sortedNotes.map((note) => (
        <a href={`/notes/${note.slug}`} class="note-window-card">
          
          {}
          <div class="card-image-wrapper">
            {note.data.coverImage ? (
              <img src={note.data.coverImage} alt={note.data.title} loading="lazy" />
            ) : (
              <div class="image-fallback">
                <span>[NO_CANVAS_SRC]</span>
              </div>
            )}
          </div>

          {}
          <div class="card-content">
            <div class="card-meta">
              <time>{fmt(note.data.date)}</time>
              {note.data.tags?.length > 0 && (
                <span class="card-tag">#{note.data.tags[0]}</span>
              )}
            </div>
            <h2 class="card-title">{note.data.title}</h2>
            {note.data.description && (
              <p class="card-desc">{note.data.description}</p>
            )}
          </div>
          
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .notes-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .page-title {
    font-size: 24px;
    font-weight: 600; 
    color: var(--accent);
    margin-bottom: 2.5rem;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .note-window-card {
    display: flex;
    flex-direction: column;
    background: #060906; 
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 
                inset 0 0 20px rgba(118, 185, 0, 0.02);
  }

  .note-window-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 
                0 0 15px rgba(118, 185, 0, 0.12),
                inset 0 0 20px rgba(118, 185, 0, 0.05);
  }

  .card-image-wrapper {
    width: 100%;
    height: 180px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: #000;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s ease, scale 0.2s ease;
  }

  .note-window-card:hover .card-image-wrapper img {
    opacity: 1;
    scale: 1.02; /* Smooth lens pull on hover */
  }


  /* Image Fallback System */
  .image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #040604 0%, #0c120c 100%);
  }
  .image-fallback span {
    font-family: monospace;
    font-size: 11px;
    color: var(--border-2);
    letter-spacing: 0.1em;
  }

  .card-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--subtle);
    margin-bottom: 0.5rem;
  }

  .card-tag {
    color: var(--accent);
  }


  .card-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
  }

  .note-window-card:hover .card-title {
    color: var(--accent-bright);
  }

  .card-desc {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .notes-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .card-image-wrapper {
      height: 150px;
    }
  }
</style>
