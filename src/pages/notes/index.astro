---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
// Sort notes by date descending
const sortedNotes = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (date: Date) =>
  date.toLocaleDateString('en-CA', { timeZone: 'UTC' });

const tagCounts: Record<string, number> = {};
allNotes.forEach(note => {
  note.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base title="notes" description="Writing and documentation">
  <div class="notes-container">
    <h1 class="page-title">notes/</h1>
    
    <div class="notes-layout">
      {/* ── Main Notes Column (Row-wise) ── */}
      <div class="notes-main-column">
        <div class="notes-list" id="notes-list">
          {sortedNotes.map((note) => (
            <article
              class="note-row"
              data-tags={JSON.stringify(note.data.tags?.map((t: string) => t.toLowerCase()) || [])}
            >
              <div class="note-date-wrap">
                <time class="note-date" datetime={note.data.date.toISOString()}>
                  {fmt(note.data.date)}
                </time>
              </div>

              <div class="note-body-wrap">
                <a href={`${base}/notes/${note.slug}`} class="note-title-link">
                  <h2 class="note-title">{note.data.title}</h2>
                </a>

                {note.data.description && (
                  <p class="note-desc">{note.data.description}</p>
                )}

                {note.data.tags && note.data.tags.length > 0 && (
                  <div class="note-tags">
                    {note.data.tags.map((tag: string) => (
                      <button
                        type="button"
                        class="row-tag-btn"
                        data-tag={tag.toLowerCase()}
                        title={`Filter by #${tag}`}
                      >
                        #{tag}
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>

        <div class="no-results" id="no-results" style="display: none;">
          <p class="no-results-msg">no notes found matching this hashtag.</p>
          <button type="button" class="reset-filter-btn" id="reset-filter-btn">
            show all notes
          </button>
        </div>
      </div>

      {/* ── Right Column: Hashtag Search Box ── */}
      <aside class="search-sidebar">
        <div class="search-box">
          <div class="search-box-header">
            <div class="search-label">
              <span class="prompt">#</span> tag search
            </div>
            <span class="match-count" id="match-count">
              {sortedNotes.length} notes
            </span>
          </div>

          <div class="search-input-wrapper">
            <span class="search-icon">#</span>
            <input
              type="text"
              id="tag-search-input"
              class="tag-search-input"
              placeholder="search hashtags..."
              autocomplete="off"
              spellcheck="false"
              aria-label="Keyword search by hashtags"
            />
            <button
              type="button"
              id="clear-search-btn"
              class="clear-search-btn"
              aria-label="Clear search"
              style="display: none;"
            >
              ✕
            </button>
          </div>

          <div class="tags-section">
            <div class="tags-section-label">hashtags</div>
            <div class="tag-chips-list" id="tag-chips-list">
              <button
                type="button"
                class="tag-chip active"
                data-tag="all"
              >
                <span class="tag-chip-name">all</span>
                <span class="tag-chip-count">{sortedNotes.length}</span>
              </button>
              {sortedTags.map(([tag, count]) => (
                <button
                  type="button"
                  class="tag-chip"
                  data-tag={tag.toLowerCase()}
                >
                  <span class="tag-chip-name">#{tag}</span>
                  <span class="tag-chip-count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  :global(main) {
    max-width: 980px !important;
  }

  .notes-container {
    width: 100%;
    padding: 1rem 0 3rem;
  }

  .page-title {
    font-size: 24px;
    font-weight: 600; 
    color: var(--accent);
    margin-bottom: 2.5rem;
    letter-spacing: -0.01em;
  }

  .notes-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 3rem;
    align-items: start;
  }

  .notes-main-column {
    min-width: 0;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
  }

  .note-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 0.5px solid var(--border);
    align-items: baseline;
    transition: background-color 0.15s ease;
  }

  .note-row:last-child {
    border-bottom: 0.5px solid var(--border);
  }

  .note-date-wrap {
    padding-top: 2px;
  }

  .note-date {
    font-size: 11.5px;
    color: var(--subtle);
    font-family: inherit;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .note-body-wrap {
    min-width: 0;
  }

  .note-title-link {
    text-decoration: none;
    display: inline-block;
  }

  .note-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.4;
    margin: 0 0 0.45rem 0;
    transition: color 0.15s ease;
  }

  .note-title-link:hover .note-title {
    color: var(--accent-bright);
    text-shadow: 0 0 4px rgba(164, 226, 52, 0.35);
  }

  .note-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 0.65rem 0;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.4rem;
  }

  .row-tag-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 11px;
    color: var(--accent);
    cursor: pointer;
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }

  .row-tag-btn:hover {
    color: var(--accent-bright);
    text-shadow: 0 0 4px rgba(164, 226, 52, 0.4);
  }

  .note-row.is-hidden {
    display: none !important;
  }

  /* ── Right Column / Search Box ── */
  .search-sidebar {
    position: sticky;
    top: 2rem;
  }

  .search-box {
    background: #060906;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.15rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4),
                inset 0 0 15px rgba(118, 185, 0, 0.02);
  }

  .search-box-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.85rem;
  }

  .search-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .match-count {
    font-size: 10.5px;
    color: var(--subtle);
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--subtle);
    font-size: 12px;
    pointer-events: none;
    font-family: inherit;
  }

  .tag-search-input {
    width: 100%;
    background: #040604;
    border: 1px solid var(--border-2);
    border-radius: 4px;
    padding: 7px 28px 7px 24px;
    font-family: inherit;
    font-size: 11.5px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .tag-search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 8px rgba(118, 185, 0, 0.2);
  }

  .tag-search-input::placeholder {
    color: var(--muted);
    opacity: 0.6;
  }

  .clear-search-btn {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    color: var(--muted);
    font-size: 11px;
    cursor: pointer;
    padding: 2px 4px;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .clear-search-btn:hover {
    color: var(--accent-bright);
  }

  .tags-section-label {
    font-size: 10px;
    color: var(--subtle);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 0.5px solid var(--border);
  }

  .tag-chips-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tag-chip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: none;
    border: 0.5px solid transparent;
    border-radius: 4px;
    padding: 5px 8px;
    font-family: inherit;
    font-size: 11px;
    color: var(--muted);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .tag-chip:hover {
    color: var(--text);
    background: rgba(118, 185, 0, 0.05);
    border-color: var(--border-2);
  }

  .tag-chip.active {
    color: var(--accent-bright);
    background: rgba(118, 185, 0, 0.08);
    border-color: rgba(118, 185, 0, 0.35);
    text-shadow: 0 0 3px rgba(164, 226, 52, 0.35);
  }

  .tag-chip-count {
    font-size: 10px;
    color: var(--subtle);
  }

  .tag-chip.active .tag-chip-count {
    color: var(--accent);
    opacity: 0.9;
  }

  .no-results {
    padding: 2.5rem 0;
    border-top: 0.5px solid var(--border);
  }

  .no-results-msg {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 0.85rem;
  }

  .reset-filter-btn {
    background: none;
    border: 0.5px solid var(--border-2);
    color: var(--accent);
    padding: 5px 12px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 11.5px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .reset-filter-btn:hover {
    color: var(--accent-bright);
    border-color: var(--accent);
    background: rgba(118, 185, 0, 0.05);
    box-shadow: 0 0 6px rgba(118, 185, 0, 0.2);
  }

  @media (max-width: 768px) {
    .notes-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .search-sidebar {
      position: static;
      order: -1;
    }

    .tag-chips-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .tag-chip {
      width: auto;
      gap: 8px;
      border: 0.5px solid var(--border);
      padding: 4px 10px;
    }

    .note-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1.25rem 0;
    }
  }
</style>

<script>
  function setupTagFilter() {
    const input = document.getElementById('tag-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('reset-filter-btn') as HTMLButtonElement | null;
    const matchCountEl = document.getElementById('match-count');
    const noResultsEl = document.getElementById('no-results');
    const rows = document.querySelectorAll<HTMLElement>('.note-row');
    const chips = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
    const rowTagBtns = document.querySelectorAll<HTMLButtonElement>('.row-tag-btn');

    if (!input || !clearBtn || !matchCountEl || !noResultsEl) return;

    const totalCount = rows.length;

    function applyFilter(query: string, activeTag?: string) {
      const normalized = query.trim().toLowerCase().replace(/^#+/, '');
      let visible = 0;

      rows.forEach((row) => {
        let tags: string[] = [];
        try {
          tags = JSON.parse(row.dataset.tags || '[]');
        } catch {
          tags = [];
        }

        const matches =
          normalized === '' ||
          normalized === 'all' ||
          tags.some((t) => t.includes(normalized));

        row.classList.toggle('is-hidden', !matches);
        if (matches) visible++;
      });

      // Update match counter
      if (normalized === '' || normalized === 'all') {
        matchCountEl!.textContent = `${totalCount} notes`;
      } else {
        matchCountEl!.textContent = `${visible} of ${totalCount} notes`;
      }

      // Show / hide no results notice
      noResultsEl!.style.display = visible === 0 ? 'block' : 'none';

      // Show / hide clear button in search input
      clearBtn!.style.display = input!.value ? 'block' : 'none';

      // Update tag chips active state
      const targetTag = activeTag || (normalized === '' ? 'all' : normalized);
      chips.forEach((chip) => {
        const chipTag = chip.dataset.tag;
        const isActive =
          chipTag === targetTag ||
          (targetTag === '' && chipTag === 'all');
        chip.classList.toggle('active', isActive);
      });

      // Update URL hash without pushing history state
      const newHash = normalized && normalized !== 'all' ? `#${encodeURIComponent(normalized)}` : '';
      if (window.location.hash !== newHash) {
        history.replaceState(
          null,
          '',
          newHash || window.location.pathname
        );
      }
    }

    // Input event for real-time searching
    input.addEventListener('input', () => {
      applyFilter(input.value);
    });

    // Clear search button
    clearBtn.addEventListener('click', () => {
      input.value = '';
      applyFilter('');
      input.focus();
    });

    // Reset filter button in no-results
    resetBtn?.addEventListener('click', () => {
      input.value = '';
      applyFilter('');
      input.focus();
    });

    // Click on hashtag chips in the right sidebar
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const tag = chip.dataset.tag || 'all';
        if (chip.classList.contains('active') && tag !== 'all') {
          // Toggle off
          input.value = '';
          applyFilter('');
        } else if (tag === 'all') {
          input.value = '';
          applyFilter('');
        } else {
          input.value = tag;
          applyFilter(tag, tag);
        }
      });
    });

    // Click on hashtag badges in individual note rows
    rowTagBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tag = btn.dataset.tag || '';
        if (tag) {
          input.value = tag;
          applyFilter(tag, tag);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });

    // Read initial hash from URL (e.g. /notes#rust)
    const initialHash = decodeURIComponent(window.location.hash.slice(1)).trim();
    if (initialHash) {
      input.value = initialHash;
      applyFilter(initialHash, initialHash);
    }
  }

  setupTagFilter();
  document.addEventListener('astro:page-load', setupTagFilter);
</script>
